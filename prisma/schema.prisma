generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Client {
  id               String    @id @default(cuid())
  name             String
  company          String?
  email            String?
  phone            String?
  whatsapp         String?
  status           String    @default("activo")
  startedAt        DateTime?
  notes            String?
  currency         String    @default("ARS")
  monthlyAmount    Decimal   @default(0) @db.Decimal(12, 2)
  initialPayment   Decimal   @default(0) @db.Decimal(12, 2)
  subscriptionType String    @default("mensual")
  subscriptionDate DateTime
  expirationDate   DateTime
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  resources   Resource[]
  socialLinks SocialLink[]
  documents   Document[]
  proposals   Proposal[]
  tasks       Task[]
  payments    Payment[]
}

model Resource {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  kind      String
  label     String
  url       String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model SocialLink {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  platform  String
  url       String
  handle    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model Document {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title     String
  category  String
  fileName  String
  mimeType  String
  path      String
  size      Int
  notes     String?
  createdAt DateTime @default(now())

  @@index([clientId])
}

model Proposal {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title     String
  amount    Decimal?  @db.Decimal(12, 2)
  status    String    @default("draft")
  sentAt    DateTime?
  notes     String?
  fileName  String?
  mimeType  String?
  path      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([clientId])
}

model Task {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title     String
  status    String   @default("todo")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, status, position])
}

model Payment {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amount    Decimal  @db.Decimal(12, 2)
  paidAt    DateTime
  notes     String?
  createdAt DateTime @default(now())

  @@index([clientId, paidAt])
}

model InboxNote {
  id        String   @id @default(cuid())
  title     String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([done, createdAt])
}
